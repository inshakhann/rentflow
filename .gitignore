## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPS/
[Release]/
[Re]lease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Log]/

# Visual Studio 2015/2017 cache directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml

# Build Performance Diagnostics
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Compiled files
*.suo
*.user
*.cache
*.swp
*.zip
*.rar
*.7z

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/

# Local database files
*.db
*.sqlite
*.sqlite3
