@page "/"
@page "/login"
@layout AuthLayout
@using RentFlow.Shared.DTOs
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>RentFlow Sign In</PageTitle>

<div class="auth-shell">
    <div class="auth-card-grid">
        <section class="auth-brand-panel">
            <div class="auth-brand-pill">RentFlow Platform</div>
            <h1>Manage properties with confidence</h1>
            <p>Unified operations for rent collection, maintenance, alerts, and analytics in one professional workspace.</p>
            <ul class="auth-feature-list">
                <li>Role-based dashboards for Admin, Landlord, and Tenant workflows</li>
                <li>Invoice tracking with late fee automation and receipts</li>
                <li>Maintenance triage, weather alerts, and AI-assisted support</li>
            </ul>
        </section>

        <section class="auth-form-panel">
            <h2>Sign In</h2>
            <p class="auth-subtitle">Welcome back. Please enter your credentials.</p>

            @if (ShowError)
            {
                <div class="alert alert-danger py-2 px-3 mb-3">
                    Invalid credentials. Please try again.
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText @bind-Value="loginModel.Email" class="form-control auth-input" placeholder="you@example.com" type="email" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="loginModel.Password" class="form-control auth-input" type="password" required />
                </div>

                <button type="submit" class="btn btn-primary auth-submit w-100" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>

                <div class="text-center mt-4">
                    <a class="auth-link" href="/register">Create a new account</a>
                </div>
            </EditForm>
        </section>
    </div>
</div>

@code {
    private LoginDto loginModel = new();
    private bool IsLoading = false;
    private bool ShowError = false;

    private async Task HandleLogin()
    {
        IsLoading = true;
        ShowError = false;

        var role = await AuthService.Login(loginModel);

        if (role != null)
        {
            ToastService.ShowSuccess("Login successful!");
            NavigateByRole(role);
            return;
        }

        ShowError = true;
        IsLoading = false;
    }

    private void NavigateByRole(string? role)
    {
        if (role == "Admin")
        {
            NavigationManager.NavigateTo("/admin/dashboard");
        }
        else if (role == "Landlord")
        {
            NavigationManager.NavigateTo("/landlord/dashboard");
        }
        else if (role == "Tenant")
        {
            NavigationManager.NavigateTo("/tenant/dashboard");
        }
    }
}
