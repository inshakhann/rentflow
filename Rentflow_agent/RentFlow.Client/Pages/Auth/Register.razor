@page "/register"
@layout AuthLayout
@using RentFlow.Shared.DTOs
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Create RentFlow Account</PageTitle>

<div class="auth-shell">
    <div class="auth-card-grid">
        <section class="auth-brand-panel">
            <div class="auth-brand-pill">RentFlow Platform</div>
            <h1>Start with a secure account</h1>
            <p>Create your workspace profile and continue to your role-based dashboard in seconds.</p>
            <ul class="auth-feature-list">
                <li>Landlord operations and property analytics</li>
                <li>Tenant rent, lease, and maintenance management</li>
                <li>Modern access controls backed by JWT authentication</li>
            </ul>
        </section>

        <section class="auth-form-panel">
            <h2>Create Account</h2>
            <p class="auth-subtitle">Register as a landlord or tenant.</p>

            @if (ShowError)
            {
                <div class="alert alert-danger py-2 px-3 mb-3">
                    Registration failed. Email might already be in use.
                </div>
            }

            @if (PasswordMismatch)
            {
                <div class="alert alert-danger py-2 px-3 mb-3">
                    Passwords do not match.
                </div>
            }

            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <InputText @bind-Value="registerModel.FullName" class="form-control auth-input" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText @bind-Value="registerModel.Email" class="form-control auth-input" type="email" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <InputSelect @bind-Value="registerModel.Role" class="form-select auth-input" required>
                        <option value="">Select a role...</option>
                        <option value="Landlord">Landlord</option>
                        <option value="Tenant">Tenant</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="registerModel.Password" class="form-control auth-input" type="password" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Confirm Password</label>
                    <InputText @bind-Value="registerModel.ConfirmPassword" class="form-control auth-input" type="password" required />
                </div>

                <button type="submit" class="btn btn-primary auth-submit w-100" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Creating account...</span>
                    }
                    else
                    {
                        <span>Create Account</span>
                    }
                </button>

                <div class="text-center mt-4">
                    <a class="auth-link" href="/login">Already have an account? Sign in</a>
                </div>
            </EditForm>
        </section>
    </div>
</div>

@code {
    private RegisterDto registerModel = new();
    private bool IsLoading = false;
    private bool ShowError = false;
    private bool PasswordMismatch = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var role = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
            if (role == "Admin") NavigationManager.NavigateTo("/admin/dashboard");
            else if (role == "Landlord") NavigationManager.NavigateTo("/landlord/dashboard");
            else if (role == "Tenant") NavigationManager.NavigateTo("/tenant/dashboard");
        }
    }

    private async Task HandleRegister()
    {
        ShowError = false;
        PasswordMismatch = false;

        if (registerModel.Password.Length < 8)
        {
            ToastService.ShowError("Password must be at least 8 characters long.");
            return;
        }

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            PasswordMismatch = true;
            return;
        }

        IsLoading = true;

        var role = await AuthService.Register(registerModel);

        if (role != null)
        {
            ToastService.ShowSuccess("Registration successful!");
            if (role == "Landlord") NavigationManager.NavigateTo("/landlord/dashboard");
            else NavigationManager.NavigateTo("/tenant/dashboard");
            return;
        }

        ShowError = true;
        IsLoading = false;
    }
}
