@page "/tenant/negotiate"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@attribute [Authorize(Roles = "Tenant")]
@inject HttpClient Http
@inject ToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>AI Rent Negotiation</PageTitle>

<div class="container py-4">
    <div class="row">
        <!-- Main Chat/Negotiator Panel -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: var(--color-white);">
                <div class="card-header bg-navy text-white p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-0 fw-bold"><i class="bi bi-robot me-2 text-teal animate-pulse"></i>RentFlow AI Negotiator</h4>
                        <small class="opacity-75">Empathetic rent negotiation & deferral advisor</small>
                    </div>
                    <span class="badge bg-teal rounded-pill px-3 py-2">Groq LLaMA 3.1</span>
                </div>
                
                <div class="card-body p-4 d-flex flex-column" style="height: 480px;">
                    <!-- Chat Messages Area -->
                    <div class="flex-grow-1 overflow-auto mb-4 pe-2 d-flex flex-column gap-3" id="chat-messages-container">
                        @foreach (var msg in chatLog)
                        {
                            var isUser = msg.Role == "user";
                            <div class="d-flex @(isUser ? "justify-content-end" : "justify-content-start") animate-fade-in">
                                <div class="d-flex align-items-start gap-2 @(isUser ? "flex-row-reverse" : "flex-row")" style="max-width: 80%;">
                                    <div class="p-2 rounded-circle shadow-sm @(isUser ? "bg-teal text-white" : "bg-navy text-white")" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                        <i class="bi @(isUser ? "bi-person-fill" : "bi-robot")"></i>
                                    </div>
                                    <div class="p-3 rounded-4 shadow-sm @(isUser ? "bg-teal-light text-navy rounded-te-0" : "bg-light text-navy rounded-ts-0")">
                                        <p class="mb-0 whitespace-pre-wrap small">@msg.Content</p>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (isThinking)
                        {
                            <div class="d-flex justify-content-start">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 rounded-circle bg-navy text-white shadow-sm" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-robot"></i>
                                    </div>
                                    <div class="p-3 rounded-4 bg-light text-muted shadow-sm">
                                        <span class="spinner-grow spinner-grow-sm text-teal" role="status"></span>
                                        <span class="spinner-grow spinner-grow-sm text-teal mx-1" role="status"></span>
                                        <span class="spinner-grow spinner-grow-sm text-teal" role="status"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Chat Input -->
                    <div class="input-group">
                        <textarea class="form-control rounded-start-pill py-3 px-4 border-end-0 border-navy border-opacity-25" 
                                  placeholder="Describe your request or current financial constraints..." 
                                  @bind="userInput" 
                                  @bind:event="oninput"
                                  @onkeydown="HandleKeyDown"
                                  disabled="@isThinking"
                                  rows="1"
                                  style="resize: none; max-height: 100px; border-radius: 30px 0 0 30px;"></textarea>
                        <button class="btn btn-navy px-4 rounded-end-pill" @onclick="SendMessage" disabled="@(isThinking || string.IsNullOrWhiteSpace(userInput))" style="border-radius: 0 30px 30px 0;">
                            <i class="bi bi-send-fill fs-5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Draft Output -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 20px; background: var(--color-white);">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold text-navy mb-3"><i class="bi bi-file-earmark-text text-teal me-2"></i>Generated Proposal Draft</h5>
                    <p class="text-muted small">Your refined landlord-ready request letter will automatically generate here when the negotiation completes.</p>
                    
                    <div class="flex-grow-1 border rounded-4 p-3 bg-light overflow-auto text-navy small mb-3 shadow-inner" style="min-height: 280px; font-family: 'Courier New', Courier, monospace; white-space: pre-wrap;">
                        @if (string.IsNullOrEmpty(draftLetter))
                        {
                            <span class="text-muted italic">Waiting for draft generation...</span>
                        }
                        else
                        {
                            @draftLetter
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(draftLetter))
                    {
                        <button class="btn btn-teal w-100 rounded-pill fw-bold" @onclick="CopyDraft">
                            <i class="bi bi-clipboard-check me-2"></i>Copy to Clipboard
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .whitespace-pre-wrap {
        white-space: pre-wrap;
    }
    .rounded-te-0 {
        border-top-right-radius: 0 !important;
    }
    .rounded-ts-0 {
        border-top-left-radius: 0 !important;
    }
    .shadow-inner {
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
    }
</style>

@code {
    private string userInput = "";
    private string draftLetter = "";
    private bool isThinking = false;
    private List<ChatMessage> chatLog = new()
    {
        new ChatMessage { Role = "assistant", Content = "Hello! I am your RentFlow AI negotiator. If you are experiencing financial difficulties, want to discuss a temporary rent deferral, or ask for a polite rent adjustment, let me know. What terms or reason would you like me to work on?" }
    };

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isThinking) return;

        var userMsg = userInput;
        userInput = "";
        
        chatLog.Add(new ChatMessage { Role = "user", Content = userMsg });
        isThinking = true;
        StateHasChanged();

        try
        {
            var req = new ChatRequest
            {
                Messages = chatLog.Select(c => new { role = c.Role, content = c.Content }).ToArray()
            };

            var response = await Http.PostAsJsonAsync("api/groq/negotiate", req);
            if (response.IsSuccessStatusCode)
            {
                var contentStr = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(contentStr);
                var root = doc.RootElement;
                
                // Parse LLaMA response payload structure
                if (root.TryGetProperty("choices", out var choices) && choices.GetArrayLength() > 0)
                {
                    var choice = choices[0];
                    if (choice.TryGetProperty("message", out var message) && message.TryGetProperty("content", out var content))
                    {
                        var reply = content.GetString() ?? "";
                        chatLog.Add(new ChatMessage { Role = "assistant", Content = "I have drafted a professional proposal letter based on our conversation. You can review and copy it from the right-hand panel." });
                        draftLetter = reply;
                    }
                }
            }
            else
            {
                ToastService.ShowError("Negotiator API encountered an issue.", "Groq Error");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Communication error: {ex.Message}");
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
        }
    }

    private async Task CopyDraft()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", draftLetter);
            ToastService.ShowSuccess("Draft proposal letter copied to clipboard!", "Copied");
        }
        catch
        {
            ToastService.ShowError("Failed to write to clipboard. Please copy manually.");
        }
    }

    public class ChatMessage
    {
        public string Role { get; set; } = "";
        public string Content { get; set; } = "";
    }

    public class ChatRequest
    {
        public object[] Messages { get; set; } = Array.Empty<object>();
    }
}
