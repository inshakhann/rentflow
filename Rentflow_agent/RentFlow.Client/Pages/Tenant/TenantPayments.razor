@page "/tenant/payments"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Tenant")]
@inject PaymentService PaymentService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Payment History</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-navy fw-bold mb-0"><i class="bi bi-wallet2 text-teal me-2"></i>Payment History</h2>
</div>

@if (payments == null)
{
    <LoadingSpinner />
}
else
{
    <div class="form-card shadow-sm border-0" style="border-radius: 16px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-navy text-white small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Due Date</th>
                        <th>Amount</th>
                        <th>Late Fee</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Paid Date</th>
                        <th class="pe-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in payments)
                    {
                        <tr>
                            <td class="ps-3 py-3 fw-bold text-navy">@payment.DueDate.ToString("MMM dd, yyyy")</td>
                            <td>Rs @payment.Amount.ToString("N0")</td>
                            <td>Rs @payment.LateFee.ToString("N0")</td>
                            <td><strong class="text-navy">Rs @((payment.Amount + payment.LateFee).ToString("N0"))</strong></td>
                            <td>
                                @if (payment.Status == "Paid")
                                {
                                    <span class="badge-paid"><i class="bi bi-check-circle-fill me-1 small"></i>Paid</span>
                                }
                                else if (payment.Status == "Late")
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-exclamation-octagon-fill me-1 small animate-pulse"></i>Late</span>
                                }
                                else
                                {
                                    <span class="badge bg-teal rounded-pill px-3 py-1 text-white"><i class="bi bi-hourglass-split me-1 small"></i>Pending</span>
                                }
                            </td>
                            <td>@(payment.PaidDate?.ToString("MMM dd, yyyy M:mm tt") ?? "-")</td>
                            <td class="pe-3 text-end">
                                @if (payment.Status != "Paid")
                                {
                                    <button class="btn btn-sm btn-teal fw-bold px-3 py-2 shadow-sm rounded-pill hover-scale" 
                                            @onclick="() => ProcessPayment(payment.Id)" 
                                            disabled="@isProcessingPayment">
                                        @if (isProcessingPayment)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-credit-card-fill me-1"></i>
                                        }
                                        Pay Now
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-navy fw-bold px-3 py-2 rounded-pill hover-scale" @onclick="() => PrintReceipt(payment.Id)">
                                        <i class="bi bi-receipt me-1"></i>Receipt
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!payments.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 opacity-50 mb-2 d-block"></i>
                                No payment invoices found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- QR Code Section -->
    <div class="row mt-4 mb-5">
        <div class="col-md-6 offset-md-3">
            <div class="qr-code-container animate-fade-in shadow-sm">
                <h5 class="fw-bold text-teal mb-3"><i class="bi bi-qr-code-scan me-2"></i>Quick Pay via QR Code</h5>
                <p class="text-muted small mb-4">Scan this code with your banking app or digital wallet to instantly navigate to the payment portal.</p>
                <div id="qr-code-render-target" class="mb-2">
                    <span class="spinner-border text-teal spinner-border-sm" role="status"></span>
                </div>
                <small class="text-teal fw-bold">@qrPaymentUrl</small>
            </div>
        </div>
    </div>
}

<!-- Hidden Printable Receipt -->
@if (receipt != null)
{
    <div id="printable-receipt" class="d-none">
        <div class="text-center mb-4 border-bottom pb-4">
            <h2>RentFlow Receipt</h2>
            <p class="text-muted">Official Payment Record</p>
        </div>
        <div class="row mb-4">
            <div class="col-6">
                <strong>Tenant:</strong> @receipt.TenantName<br />
                <strong>Email:</strong> @receipt.TenantEmail
            </div>
            <div class="col-6 text-end">
                <strong>Property:</strong> @receipt.PropertyName<br />
                <strong>Unit:</strong> @receipt.UnitNumber
            </div>
        </div>
        <table class="table table-bordered mb-4">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Monthly Rent (Due @receipt.DueDate.ToString("MMM dd, yyyy"))</td>
                    <td class="text-end">Rs @receipt.Amount.ToString("N0")</td>
                </tr>
                @if (receipt.LateFee > 0)
                {
                    <tr>
                        <td>Late Fee</td>
                        <td class="text-end">Rs @receipt.LateFee.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td class="text-end">Total Paid</td>
                    <td class="text-end">Rs @receipt.Total.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
        <div class="text-center mt-5">
            <p>Paid on @(receipt.PaidDate?.ToString("MMM dd, yyyy M:mm tt"))</p>
            <p class="small text-muted">Thank you for your prompt payment.</p>
        </div>
    </div>
}

<style>
    .hover-scale {
        transition: transform 0.2s ease;
    }
    .hover-scale:hover {
        transform: translateY(-1px);
    }
    .qr-code-container {
        border: 2px dashed var(--color-teal);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        background: var(--color-teal-light);
    }
    @@media print {
        .d-none#printable-receipt {
            display: block !important;
        }
    }
</style>

@code {
    private List<TenantPaymentHistory>? payments;
    private bool isProcessingPayment = false;
    private ReceiptData? receipt;
    private string qrPaymentUrl = "";
    private string qrBase64 = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadQrCode();
        }
    }

    private async Task LoadHistory()
    {
        payments = await PaymentService.GetTenantHistory();
    }

    private async Task LoadQrCode()
    {
        try
        {
            var response = await HttpClientFactory.CreateClient("ServerAPI").GetFromJsonAsync<QrCodeResponse>("api/qrcode/tenant");
            if (response != null)
            {
                qrBase64 = response.QrBase64;
                qrPaymentUrl = response.PaymentUrl;
                await JSRuntime.InvokeVoidAsync("renderQrImage", "qr-code-render-target", qrBase64);
                StateHasChanged();
            }
        }
        catch { /* ignore qr errors */ }
    }

    private async Task ProcessPayment(int paymentId)
    {
        if (isProcessingPayment) return;
        isProcessingPayment = true;
        StateHasChanged();

        try
        {
            var success = await PaymentService.PayPayment(paymentId);
            if (success)
            {
                ToastService.ShowSuccess("Rs " + (payments?.FirstOrDefault(p => p.Id == paymentId)?.Amount.ToString("N0") ?? "") + " paid successfully!", "Payment Confirmed");
                await LoadHistory();
            }
            else
            {
                ToastService.ShowError("Could not complete payment on the server.", "Payment Error");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Payment service error: {ex.Message}", "System Failure");
        }
        finally
        {
            isProcessingPayment = false;
            StateHasChanged();
        }
    }

    private async Task PrintReceipt(int paymentId)
    {
        receipt = await PaymentService.GetReceiptData(paymentId);
        StateHasChanged();
        
        if (receipt != null)
        {
            // Give DOM a tick to render the hidden receipt html
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("printReceipt");
        }
    }

    public class QrCodeResponse
    {
        public string QrBase64 { get; set; } = "";
        public string PaymentUrl { get; set; } = "";
    }
}
