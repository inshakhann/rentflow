@page "/tenant/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Tenant")]
@inject PaymentService PaymentService
@inject MaintenanceService MaintenanceService

<PageTitle>Tenant Dashboard</PageTitle>

@if (isLoading)
{
    <LoadingSpinner />
}
else
{
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="stat-card" style="border-left-color: var(--color-teal)">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="card-title">Next Payment</div>
                        <div class="stat-value">
                            @if (nextPayment != null)
                            {
                                <span>Rs @(nextPayment.Amount + nextPayment.LateFee)</span>
                            }
                            else
                            {
                                <span>Up to date</span>
                            }
                        </div>
                        @if (nextPayment != null)
                        {
                            <div class="text-muted small mt-1">Due: @nextPayment.DueDate.ToString("MMM dd, yyyy")</div>
                        }
                    </div>
                    <div class="p-3 bg-teal-light rounded-circle text-teal">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="stat-card" style="border-left-color: var(--color-danger)">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="card-title">Late Fees</div>
                        <div class="stat-value">Rs @payments?.Where(p => p.Status == "Late").Sum(p => p.LateFee)</div>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 rounded-circle text-danger">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="stat-card" style="border-left-color: var(--color-amber)">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="card-title">My Tickets</div>
                        <div class="stat-value">@tickets?.Count</div>
                    </div>
                    <div class="p-3 bg-amber-light rounded-circle text-amber">
                        <i class="bi bi-tools fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="form-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0">Recent Payments</h4>
                    <a href="tenant/payments" class="btn btn-sm btn-outline-navy">View All</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (payments == null || !payments.Any(p => p.Status == "Paid"))
                    {
                        <div class="text-center py-3 text-muted">No recent payments.</div>
                    }
                    else
                    {
                        @foreach (var payment in payments.Where(p => p.Status == "Paid").Take(3))
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Rs @(payment.Amount + payment.LateFee)</strong>
                                        <div class="text-muted small">Paid on @payment.PaidDate?.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    <span class="badge-paid"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="form-card h-100 bg-teal text-white">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-robot fs-2 me-3"></i>
                    <h4 class="mb-0 text-white">Smart Maintenance</h4>
                </div>
                <p class="mb-4 text-white-50">Having an issue? Chat with our AI bot to instantly classify and route your maintenance request to the right person.</p>
                <a href="tenant/maintenance" class="btn btn-light text-teal w-100 fw-bold py-2">Start Chat <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>
    </div>
}

@code {
    private List<TenantPaymentHistory>? payments;
    private List<TenantTicketView>? tickets;
    private TenantPaymentHistory? nextPayment;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var tasks = new List<Task>
        {
            Task.Run(async () => payments = await PaymentService.GetTenantHistory()),
            Task.Run(async () => tickets = await MaintenanceService.GetTenantTickets())
        };

        await Task.WhenAll(tasks);
        
        if (payments != null)
        {
            nextPayment = payments.Where(p => p.Status == "Pending" || p.Status == "Late")
                                  .OrderBy(p => p.DueDate)
                                  .FirstOrDefault();
        }
        
        isLoading = false;
    }
}
