@page "/landlord/revenue"
@using Microsoft.AspNetCore.Authorization
@using RentFlow.Shared.DTOs
@attribute [Authorize(Roles = "Landlord")]
@inject PropertyService PropertyService
@inject PaymentService PaymentService
@inject ToastService ToastService
@inject HttpClient Http

<PageTitle>Financial Analytics</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
    <div>
        <h2 class="text-navy fw-bold mb-0">Financial Analytics</h2>
        <small class="text-muted">Real-time revenue metrics, YTD ledger, and monthly rent charts</small>
    </div>
    <button class="btn btn-teal rounded-pill px-4" @onclick="OpenReportModal">
        <i class="bi bi-file-earmark-pdf-fill me-2"></i>Export Report
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <LoadingSpinner />
    </div>
}
else
{
    <!-- Stat Grid -->
    <div class="row mb-4 animate__animated animate__fadeInUp">
        <div class="col-md-4 mb-3">
            <div class="card glass-card p-4 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block small text-muted fw-bold">TOTAL REVENUE (YTD)</span>
                        <h2 class="text-green fw-bold m-0 mt-1">Rs @(revenue?.Sum(r => r.Total).ToString("N0") ?? "0")</h2>
                    </div>
                    <div class="p-3 bg-green-light rounded-circle text-green shadow-sm">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Collected across all active tenancies</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card glass-card p-4 border-0 shadow-sm" style="border-left: 4px solid var(--color-teal) !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block small text-muted fw-bold">PORTFOLIO OCCUPANCY</span>
                        <h2 class="text-teal fw-bold m-0 mt-1">@occupancyRate%</h2>
                    </div>
                    <div class="p-3 bg-teal-light rounded-circle text-teal shadow-sm">
                        <i class="bi bi-percent fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">@occupiedUnits occupied of @totalUnits total units</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card glass-card p-4 border-0 shadow-sm" style="border-left: 4px solid var(--color-danger) !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="d-block small text-muted fw-bold">OUTSTANDING ARREARS</span>
                        <h2 class="text-danger fw-bold m-0 mt-1">Rs @(latePayments?.Sum(l => l.Amount + l.LateFee).ToString("N0") ?? "0")</h2>
                    </div>
                    <div class="p-3 bg-red-light rounded-circle text-danger shadow-sm">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Accumulating surcharge fees on late dues</div>
            </div>
        </div>
    </div>

    <!-- Revenue overview chart -->
    <div class="row mb-4 animate__animated animate__fadeInUp">
        <div class="col-12">
            <div class="card glass-card p-4 border-0 shadow-sm">
                <h4 class="text-navy fw-bold mb-3 border-bottom pb-2">Revenue History</h4>
                <div style="height: 350px; position: relative;">
                    <canvas id="fullRevenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Arrears details table -->
    <div class="row animate__animated animate__fadeInUp">
        <div class="col-12">
            <div class="card glass-card p-4 border-0 shadow-sm">
                <h4 class="text-navy fw-bold mb-4 border-bottom pb-2">Unpaid & Late Rent Ledgers</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Unit Number</th>
                                <th>Overdue Since</th>
                                <th>Original Rent</th>
                                <th>Late Penalty</th>
                                <th>Total Overdue</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (latePayments == null || !latePayments.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-green fw-bold">
                                        <i class="bi bi-shield-check fs-1 d-block mb-3"></i>
                                        Excellent! No outstanding arrears on your portfolio.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var late in latePayments)
                                {
                                    <tr class="hover-row">
                                        <td class="fw-bold text-navy">@late.TenantName</td>
                                        <td>
                                            <span class="badge bg-teal bg-opacity-10 text-teal px-3 py-2 rounded-pill fw-bold">
                                                Unit @late.UnitNumber
                                            </span>
                                        </td>
                                        <td>@late.DaysOverdue Days Ago</td>
                                        <td>Rs @late.Amount.ToString("N0")</td>
                                        <td class="text-danger fw-bold">+Rs @late.LateFee.ToString("N0")</td>
                                        <td class="text-danger fw-bold fs-6">Rs @((late.Amount + late.LateFee).ToString("N0"))</td>
                                        <td class="text-end">
                                            <span class="badge bg-red bg-opacity-15 text-danger px-3 py-2 rounded-pill fw-bold">OVERDUE</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Report Modal -->
    @if (showReportModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header bg-navy text-white" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-pdf-fill me-2"></i>Generate Monthly Financial Report</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseReportModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row mb-4">
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-navy">Month</label>
                                <select class="form-select" @bind="selectedMonth">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@(new DateTime(2020, m, 1).ToString("MMMM"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-navy">Year</label>
                                <select class="form-select" @bind="selectedYear">
                                    @for (int y = DateTime.UtcNow.Year - 3; y <= DateTime.UtcNow.Year + 1; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-teal w-100 fw-bold" @onclick="FetchReport" disabled="@isFetchingReport">
                                    @if (isFetchingReport)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>Load</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (reportData != null)
                        {
                            <div class="p-4 border rounded-3 bg-light shadow-inner mb-3">
                                <h5 class="fw-bold text-navy border-bottom pb-2 mb-3">Report Preview: @(new DateTime(2020, reportData.Month, 1).ToString("MMMM")) @reportData.Year</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-2"><strong>Total Income:</strong> Rs @reportData.TotalIncome.ToString("N0")</div>
                                    <div class="col-md-6 mb-2"><strong>Late Penalties:</strong> Rs @reportData.TotalLateFees.ToString("N0")</div>
                                    <div class="col-md-6 mb-2"><strong>Paid Invoices:</strong> @reportData.PaidPayments</div>
                                    <div class="col-md-6 mb-2"><strong>Late Invoices:</strong> @reportData.LatePayments</div>
                                    <div class="col-md-6 mb-2"><strong>Open Maintenance Tickets:</strong> @reportData.OpenTickets</div>
                                    <div class="col-md-6 mb-2"><strong>Occupancy Rate:</strong> @reportData.OccupancyRate%</div>
                                </div>
                            </div>

                            <button class="btn btn-outline-navy w-100 fw-bold" @onclick="PrintReport">
                                <i class="bi bi-printer me-2"></i>Print / Export to PDF
                            </button>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-1 opacity-50 mb-2 d-block"></i>
                                Select Month and Year, then click Load to preview report.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Hidden Printable Monthly Report -->
    @if (reportData != null)
    {
        <div id="printable-monthly-report" class="d-none">
            <div class="text-center mb-5 border-bottom pb-4">
                <h2>RentFlow Monthly Report</h2>
                <h4 class="text-muted">@(new DateTime(2020, reportData.Month, 1).ToString("MMMM")) @reportData.Year</h4>
                <p class="small text-muted">Generated on @DateTime.UtcNow.ToString("MMM dd, yyyy M:mm tt")</p>
            </div>
            <div class="row mb-5">
                <div class="col-6">
                    <h5>Portfolio Status</h5>
                    <strong>Total Units:</strong> @reportData.TotalUnits<br />
                    <strong>Occupied Units:</strong> @reportData.OccupiedUnits<br />
                    <strong>Occupancy Rate:</strong> @reportData.OccupancyRate%
                </div>
                <div class="col-6 text-end">
                    <h5>Maintenance Status</h5>
                    <strong>Active Open Tickets:</strong> @reportData.OpenTickets
                </div>
            </div>
            <table class="table table-bordered mb-5">
                <thead class="table-dark">
                    <tr>
                        <th>Financial Category</th>
                        <th class="text-end">Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total Income Collected</td>
                        <td class="text-end">Rs @reportData.TotalIncome.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Late Fees / Penalties Surcharged</td>
                        <td class="text-end">Rs @reportData.TotalLateFees.ToString("N0")</td>
                    </tr>
                    <tr class="table-secondary fw-bold">
                        <td>Total Portfolio Revenue</td>
                        <td class="text-end">Rs @((reportData.TotalIncome + reportData.TotalLateFees).ToString("N0"))</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Invoice Status</th>
                        <th class="text-end">Count</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Paid Invoices</td>
                        <td class="text-end">@reportData.PaidPayments</td>
                    </tr>
                    <tr>
                        <td>Pending Invoices</td>
                        <td class="text-end">@reportData.PendingPayments</td>
                    </tr>
                    <tr>
                        <td>Late / Overdue Invoices</td>
                        <td class="text-end text-danger">@reportData.LatePayments</td>
                    </tr>
                </tbody>
            </table>

            <div class="text-center mt-5 pt-5 border-top">
                <p class="small text-muted">RentFlow Compliant Property Management System Portal</p>
            </div>
        </div>
    }
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 16px !important;
    }
    .hover-row:hover {
        background-color: var(--color-gray-100) !important;
    }
    .bg-teal-light { background-color: var(--color-teal-light); }
    .bg-green-light { background-color: var(--color-green-light); }
    .bg-red-light { background-color: var(--color-red-light); }
    .text-teal { color: var(--color-teal); }
    .text-green { color: var(--color-green); }
</style>

@code {
    private List<RevenueItem>? revenue;
    private List<LatePaymentItem>? latePayments;
    private List<PropertyView>? properties;
    private bool isLoading = true;

    // Report Generation States
    private bool showReportModal = false;
    private bool isFetchingReport = false;
    private int selectedMonth = DateTime.UtcNow.Month;
    private int selectedYear = DateTime.UtcNow.Year;
    private MonthlyReportResponse? reportData;

    // Computed Stats
    private int totalUnits = 0;
    private int occupiedUnits = 0;
    private double occupancyRate = 0;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var tasks = new List<Task>
        {
            Task.Run(async () => revenue = await PaymentService.GetLandlordRevenue()),
            Task.Run(async () => latePayments = await PaymentService.GetLatePayments()),
            Task.Run(async () => properties = await PropertyService.GetProperties())
        };

        await Task.WhenAll(tasks);

        if (properties != null)
        {
            // Gather units count using detailed properties fetch
            foreach (var prop in properties)
            {
                var details = await PropertyService.GetProperty(prop.Id);
                if (details != null)
                {
                    totalUnits += details.Units.Count;
                    occupiedUnits += details.Units.Count(u => u.IsOccupied);
                }
            }
            occupancyRate = totalUnits > 0 ? Math.Round((double)occupiedUnits / totalUnits * 100) : 0;
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && revenue != null && revenue.Count > 0)
        {
            var labels = revenue.Select(r => r.Label).ToArray();
            var data = revenue.Select(r => r.Total).ToArray();
            await JSRuntime.InvokeVoidAsync("renderBarChart", "fullRevenueChart", labels, data);
        }
    }

    private void OpenReportModal()
    {
        reportData = null;
        selectedMonth = DateTime.UtcNow.Month;
        selectedYear = DateTime.UtcNow.Year;
        showReportModal = true;
    }

    private void CloseReportModal()
    {
        showReportModal = false;
    }

    private async Task FetchReport()
    {
        isFetchingReport = true;
        StateHasChanged();
        try
        {
            reportData = await Http.GetFromJsonAsync<MonthlyReportResponse>($"api/report/monthly?month={selectedMonth}&year={selectedYear}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch report: {ex.Message}");
        }
        finally
        {
            isFetchingReport = false;
            StateHasChanged();
        }
    }

    private async Task PrintReport()
    {
        if (reportData != null)
        {
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("printReceipt"); // Reusing same print js func
        }
    }

    public class MonthlyReportResponse
    {
        public int Month { get; set; }
        public int Year { get; set; }
        public decimal TotalIncome { get; set; }
        public decimal TotalLateFees { get; set; }
        public int PaidPayments { get; set; }
        public int PendingPayments { get; set; }
        public int LatePayments { get; set; }
        public int OpenTickets { get; set; }
        public double OccupancyRate { get; set; }
        public int TotalUnits { get; set; }
        public int OccupiedUnits { get; set; }
    }
}
